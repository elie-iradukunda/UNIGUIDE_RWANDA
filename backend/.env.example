NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:5173

DEMO_MODE=true
ALLOW_DEMO_FALLBACK=true

DB_HOST=localhost
DB_PORT=3306
DB_NAME=uniguide
DB_USER=root
DB_PASS=
DB_SSL=false

JWT_SECRET=replace_with_at_least_32_random_characters
SEED_PASSWORD=password123

# --- Email -----------------------------------------------------------------
# MAIL_PROVIDER=gmail   Gmail SMTP. Delivers to ANY recipient, so use this for real
#                       testing. Needs 2-Step Verification on the Google account and
#                       an App Password (16 characters, NOT the normal Gmail
#                       password): https://myaccount.google.com/apppasswords
#
# MAIL_PROVIDER=resend  Resend API, for production. Resend only delivers to
#                       arbitrary recipients from a domain you have VERIFIED in the
#                       Resend dashboard. With the default onboarding sender it
#                       delivers only to the Resend account owner's own address.
#
# With neither set, emails are logged instead of sent and the API returns the code
# as `devCode`, so the offline demo and the verification suite still complete.
MAIL_PROVIDER=gmail
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM=UniGuide Rwanda <noreply@your-verified-domain.rw>

APP_NAME=UniGuide Rwanda
APP_URL=http://localhost:5001

# --- Registration identity gate --------------------------------------------
# Only these email domains may open a student account. Keep gmail.com ONLY while
# testing: in production set this to the college domain alone, or anyone with a
# Gmail address can register.  Production value:  STUDENT_EMAIL_DOMAINS=tct.ac.rw
STUDENT_EMAIL_DOMAINS=tct.ac.rw,rp.ac.rw,uniguide.rw,gmail.com

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
